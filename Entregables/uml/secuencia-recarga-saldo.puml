@startuml secuencia-recarga-saldo-aliflow

title Secuencia — Recargar saldo (UC2)

actor Estudiante
participant "Módulo de Wallet\n(API)" as API
participant "Pasarela de Pagos" as Pasarela
participant "Pago" as Pago
participant "SaldoEstablecimiento" as Saldo
participant "ComprobanteRecarga" as Comp

Estudiante -> API : solicitarRecarga(monto)
activate API

API -> Pasarela : procesarPago(monto)
activate Pasarela
Pasarela --> API : resultado (APROBADO | PENDIENTE | RECHAZADO)
deactivate Pasarela

alt RECHAZADO
  API -> Pago : crear(estado=RECHAZADO)
  API --> Estudiante : error de pago
else PENDIENTE
  API -> Pago : crear(estado=PENDIENTE)
  API --> Estudiante : recarga pendiente de confirmación
else APROBADO
  API -> Pago : crear(estado=APROBADO)
  API -> Saldo : acreditar(monto)\n(saldo del local destino, atómico)
  note right of Saldo
    Decisión de el cliente:
    la recarga es **por establecimiento**.
    El dinero va directo a la cuenta de
    ese proveedor — Aliflow no lo custodia.
    Ya no hay bolsa única ni distribución
    interna que repartir.
  end note
  API -> Comp : generar(sinValidezTributaria=true)
  API --> Estudiante : saldo actualizado
end

deactivate API

@enduml
