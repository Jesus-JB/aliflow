@startuml diagrama-componentes-aliflow

skinparam componentStyle rectangle
left to right direction

actor Estudiante
actor "Proveedor\n(administrador del local)" as Proveedor
actor Operador
actor "Super-Admin\nde Aliflow" as SuperAdmin

package "Cliente" {
  [Aliflow Web\n(Next.js + TypeScript)] as WEB
}

package "Aliflow API (FastAPI)" {
  [Módulo de Autenticación] as AUTH
  [Módulo de Wallet\n(saldo, recargas, pagos)] as WALLET
  [Módulo de Órdenes\n(compra, código de retiro)] as ORDERS
  [Módulo de Proveedores y Menú] as PROVMOD
  [Módulo de Inventario Reservado\n(cupo exclusivo de Aliflow)] as INVMOD
  [Módulo de Usuarios del Local\n(altas de Proveedores y Operadores)] as USERMOD
  [Módulo de Fidelidad\n(cartillas, sellos, canjes)] as LOYALTY
  [Módulo de Plataforma\n(alta de locales, soporte)] as PLATMOD
}

package "Capa de Integración" {
  interface IInventoryProvider
  [ProviderAdapterFactory] as FACTORY
  [ContificoAdapter] as CONTIFICOA
  [AlpwinAdapter] as ALPWINA
  [OdooAdapter] as ODOOA

  FACTORY --> IInventoryProvider
  CONTIFICOA -up-( IInventoryProvider
  ALPWINA -up-( IInventoryProvider
  ODOOA -up-( IInventoryProvider
}

package "Procesamiento asíncrono" {
  [Cola de eventos\n(Redis)] as QUEUE
  [Worker de Sincronización\n(Celery)] as WORKER
}

database "PostgreSQL" as DB

cloud "Proveedor de Identidad\n(Google OAuth)" as IDP
cloud "Pasarela de Pagos\n(Kushki / PayPhone / Stripe)" as PAY
cloud "ERP de cada local\n(Barú → Contífico,\nCaramel Coffee → Alpwin, …)" as ERP

Estudiante --> WEB
Proveedor --> WEB
Operador --> WEB
SuperAdmin --> WEB

WEB --> AUTH : HTTPS/REST
WEB --> WALLET : HTTPS/REST
WEB --> ORDERS : HTTPS/REST
WEB --> PROVMOD : HTTPS/REST
WEB --> INVMOD : HTTPS/REST
WEB --> USERMOD : HTTPS/REST
WEB --> PLATMOD : HTTPS/REST

ORDERS --> INVMOD : valida cupo disponible
PAY --> WALLET : webhook de confirmación\n(aprobada / rechazada / pendiente)
WEB --> LOYALTY : HTTPS/REST

AUTH --> IDP : OAuth 2.0 / OIDC
WALLET --> PAY : procesar pago

AUTH --> DB
WALLET --> DB
ORDERS --> DB
PROVMOD --> DB
USERMOD --> DB
LOYALTY --> DB

ORDERS --> LOYALTY : entrega confirmada\n(acreditar sello)
ORDERS --> QUEUE : publica evento\n(venta confirmada)
PROVMOD --> QUEUE : publica evento\n(cambio de menú/stock)

WORKER --> QUEUE : consume
WORKER --> IInventoryProvider : usa
WORKER --> DB : actualiza estado\nde sincronización

CONTIFICOA <--> ERP : REST bidireccional\n(lee inventario / notifica ventas y pagos)
ODOOA <--> ERP : JSON-RPC bidireccional
ALPWINA <--> ERP : archivos / BD puente\n(sin API pública)

note bottom of CONTIFICOA
  Adaptador del **local piloto**: Barú usa
  Contífico, que sí tiene API REST documentada.
  Ver Hallazgos-Ingenieria-API-Generica.md
  secciones 2.2 y 4.3.
end note

note bottom of ALPWINA
  Segundo local real: Caramel Coffee usa
  Alpwin, que **no** tiene API pública —
  este adaptador es el caso difícil, pero
  ya no bloquea el piloto. Ver sección 4.3.
end note

note bottom of LOYALTY
  Requisito nuevo: cartilla
  de fidelidad. Módulo aparte y no lógica
  dentro de Órdenes, porque las reglas
  (cuántos sellos, qué premio, si caduca)
  las define cada local y todavía no están
  cerradas — conviene que cambien sin tocar
  el módulo que mueve dinero e inventario.
end note

note right of QUEUE
  Redis cumple doble función: caché y
  broker de Celery — implementa el
  patrón Outbox ya diseñado
  (Hallazgos-Ingenieria-API-Generica.md
  sección 3.4).
end note

@enduml
