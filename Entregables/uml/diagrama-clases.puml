@startuml diagrama-clases-aliflow

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

' Convención visual: elementos en amarillo son PROPUESTA DE INGENIERÍA
' pendiente de validar con Negocios, no una decisión ya confirmada.
' Ver Documentacion-Diagrama-Clases.md, sección "Supuestos y pendientes".
skinparam class<<propuesta>> {
  BackgroundColor #FFF3B0
  BorderColor #8A6D00
}
skinparam note<<propuesta>> {
  BackgroundColor #FFF3B0
  BorderColor #8A6D00
}

legend top left
  <back:#FFF3B0>  </back> = propuesta de Ingeniería, pendiente de validar con Negocios
  <back:#F1F1F1>  </back> = confirmado en acta / flujo funcional / decisión de Negocios
endlegend

package "Usuarios" {
  abstract class Usuario {
    # id: UUID
    # nombreCompleto: String
    # email: String
    # fechaRegistro: DateTime
    # activo: boolean
    + autenticar(): Sesion
  }

  class Estudiante extends Usuario {
    - dominioInstitucional: String
    - codigoInstitucional: String
    + consultarSaldo(): Money
  }

  abstract class UsuarioProveedor extends Usuario {
    # proveedor: Proveedor
  }

  class Administrador extends UsuarioProveedor {
    + administrarMenu(): void
    + consultarMetricas(): MetricasProveedor
    + gestionarUsuariosDelLocal(): void
    + configurarIntegracionERP(): IntegracionERP
  }

  class Operador extends UsuarioProveedor {
    - puntoDeEntrega: PuntoDeEntrega
    + buscarOrden(codigo: String): Orden
    + confirmarEntrega(orden: Orden): void
  }

  class SuperAdmin extends Usuario {
    + darDeAltaLocal(datos: DatosLocal): Proveedor
    + configurarIntegracionERP(p: Proveedor): IntegracionERP
    + brindarSoporte(p: Proveedor): void
    + administrarPlataforma(): void
  }

  note right of SuperAdmin
    **Confirmado por Negocios el 8-ago-2026.**
    Cuarto rol, del lado de **Aliflow**. Extiende
    Usuario directamente y **no** UsuarioProveedor,
    porque no pertenece a ningún local: es el único
    rol con visibilidad sobre todos los tenants.
    Da de alta locales nuevos, les crea su vista de
    proveedor y configura su integración con el ERP.

    Este rol se había eliminado el 28-jul por
    indicación de Negocios, se repuso el 30-jul de
    palabra y quedó confirmado el 8-ago. El respaldo
    documental lo aporta el acta de conformidad de la
    especificación de requerimientos.
  end note

  note bottom of Administrador
    **Vocabulario — cuidado con "Proveedor".**
    El sistema tiene **4 roles primarios** (confirmados
    el 8-ago-2026): Estudiante, Operador, **Proveedor**
    y Super-Admin.

    El rol de negocio "Proveedor" es esta clase
    `Administrador` — la **persona** que gerencia el
    local, a la que Negocios llama indistintamente
    "Proveedor" o "Administrador". La clase `Proveedor`
    de abajo es el **local/negocio** (el tenant), no
    una persona.
  end note
}

package "Proveedor y Menú" {
  class Proveedor {
    - id: UUID
    - nombreComercial: String
    - ruc: String
    - fechaAlta: DateTime
    - activo: boolean
    - horaMaximaRetiro: Time
    - cuentaBancariaDestino: String
    - credencialesComercioCifradas: String
    + configurarHoraMaximaRetiro(h: Time): void
  }

  note left of Proveedor
    <back:#FFF3B0>Acta 30-jul-2026:</back> **horaMaximaRetiro** no
    puede ser una constante del sistema. Cada local
    la configura y el mensaje que ve el estudiante
    tras comprar ("puedes retirar hasta las 2:00 p.m.")
    se arma con ese valor.

    **cuentaBancariaDestino / credencialesComercioCifradas**
    (decisión #13, cerrada el 8-ago-2026): el dinero de
    cada recarga llega **directo a la cuenta de ese
    proveedor** y Aliflow no custodia fondos en ningún
    punto. Como consecuencia, **cada local necesita su
    propia cuenta de comercio en la pasarela** — un local
    que no pueda abrirla no puede vender por Aliflow
    (riesgo R-22).
  end note

  note right of Proveedor
    El **local** de comida dentro de la universidad
    (Barú, Caramel Coffee, …). Cada uno es un tenant
    independiente, con su propio ERP, su propio menú
    y su propio personal.
  end note

  class PuntoDeEntrega {
    - id: UUID
    - nombre: String
    - ubicacion: String
  }

  class Plato {
    - id: UUID
    - nombre: String
    - descripcion: String
    - precio: Money
    - stockDisponible: int
    - version: int
    - activo: boolean
    + hayStock(cantidad: int): boolean
    + reservarStock(cantidad: int): boolean
  }

  note right of Plato
    **version** habilita bloqueo optimista:
    reservarStock() solo aplica el descuento
    si version no cambió desde la lectura
    (evita que dos compras se lleven la
    última unidad). Detalle exacto de la
    transacción en el diagrama de secuencia.
  end note

  class InventarioReservado {
    - id: UUID
    - cupoAsignado: int
    - cupoConsumido: int
    - version: int
    - fechaVigencia: Date
    + disponible(): int
    + asignarCupo(cantidad: int): void
    + consumir(cantidad: int): boolean
  }

  note bottom of InventarioReservado
    <back:#FFF3B0>Acta 30-jul-2026 — el cambio de fondo.</back>
    El proveedor aparta un cupo **exclusivo para
    Aliflow** (de 100 almuerzos: 75 caja, 25 Aliflow)
    y lo administra manualmente desde su panel.

    **Aliflow valida la compra contra `disponible()`,
    no contra `Plato.stockDisponible` del ERP.** Eso
    elimina la sobreventa por diseño: Aliflow deja de
    competir con la caja por el mismo dato, en vez de
    intentar ganarle sincronizando más rápido.

    `Plato.stockDisponible` queda como espejo
    informativo del ERP, útil para conciliación y
    para que el proveedor decida cuánto asignar.
  end note

  Proveedor "1" *-- "1..*" Administrador : gerencia el local
  Proveedor "1" *-- "0..*" Operador : personal de entrega
  Proveedor "1" *-- "0..*" PuntoDeEntrega
  Proveedor "1" *-- "0..*" Plato : menú
  Plato "1" *-- "0..1" InventarioReservado : cupo Aliflow
  Operador "0..*" --> "1" PuntoDeEntrega : trabaja en
}

package "Wallet y Pagos" {
  class TarjetaVirtual {
    - id: UUID
    + saldoEn(proveedor: Proveedor): Money
  }

  note right of TarjetaVirtual
    **Decisión de Negocios (8-ago-2026):**
    ya **no** tiene `saldoDisponible`. El saldo
    no es del estudiante sino **del establecimiento**:
    la tarjeta es solo el contenedor que agrupa
    un `SaldoEstablecimiento` por cada local en
    el que el estudiante haya recargado.

    Modelo de referencia aportado por el cliente:
    la app **Parqueo Positivo** — se elige un
    servicio por defecto y el saldo pertenece a
    ese servicio.
  end note

  class SaldoEstablecimiento {
    - id: UUID
    - monto: Money
    + acreditar(cantidad: Money): void
    + descontar(cantidad: Money): boolean
  }

  note bottom of SaldoEstablecimiento
    **Este es el saldo real del estudiante en ese
    local**, y solo puede gastarse ahí (RN-13).
    Antes se llamaba `SaldoProveedor` y era otra
    cosa: el libro interno de lo que Aliflow le
    debía al local. **Ese libro ya no existe**,
    porque el dinero nunca pasa por Aliflow.

    Una compra en el local A jamás puede consumir
    el `SaldoEstablecimiento` del local B, ni
    existe transferencia entre ellos: mover dinero
    entre cuentas de terceros es justo lo que el
    acta §3.9 prohíbe.
  end note

  class Recarga {
    - id: UUID
    - montoTotal: Money
    - fechaHora: DateTime
    - numeroOperacion: String
    - estadoTransaccion: EstadoPago
    - idPasarela: String
    - usuarioQueRecargo: Estudiante
    - proveedorDestino: Proveedor
    + aplicar(saldo: SaldoEstablecimiento): void
  }

  note left of Recarga
    <back:#FFF3B0>Acta 30-jul-2026 §2.1 — campos mínimos.</back>
    Cada recarga debe registrar valor, fecha y hora,
    **número de operación**, **estado de la transacción**,
    **identificador de la pasarela**, usuario que
    recargó, y quedar en histórico para auditoría
    y conciliación.

    **`proveedorDestino` (8-ago-2026):** toda recarga
    tiene un establecimiento destino obligatorio. El
    dinero va de la pasarela a **la cuenta de ese
    proveedor**; Aliflow no lo recibe en ningún momento.

    El comprobante que se emite aquí **no tiene validez
    tributaria**: recargar todavía no es comprar un
    alimento. La factura la emite el ERP del local
    recién en la compra.
  end note

  note as N_StrategyEliminada
    **Se eliminó el patrón Strategy
    `EstrategiaDistribucionRecarga`** (8-ago-2026).

    Existía para encapsular *cómo* Aliflow repartía
    internamente una recarga única entre los locales.
    Con la recarga por establecimiento **ya no hay
    reparto que hacer**: el dinero llega directo a un
    único destinatario conocido desde el principio.

    Se retira en vez de conservarse porque un patrón
    sin un problema que resolver es sobre-ingeniería
    — el mismo criterio por el que este diagrama nunca
    incluyó Singleton ni Observer. Los patrones que
    quedan (Adapter, Factory Method, Outbox) sí
    responden a problemas reales y vigentes.
  end note

  class ComprobanteRecarga {
    - id: UUID
    - fechaEmision: DateTime
    - sinValidezTributaria: boolean = true
  }

  enum EstadoPago {
    APROBADO
    PENDIENTE
    RECHAZADO
  }

  class Pago {
    - id: UUID
    - monto: Money
    - estado: EstadoPago
    - fechaHora: DateTime
    - idTransaccionPasarela: String
  }

  class MetodoPago #FFF3B0 {
    - id: UUID
    - tipoTarjeta: String
    - ultimosCuatroDigitos: String(4)
    - tokenPasarela: String
    - predeterminado: boolean
  }

  note bottom of MetodoPago
    <back:#FFF3B0>Acta 30-jul-2026 §3.2 y §3.3.</back>
    Aliflow **nunca** almacena el número completo
    de la tarjeta ni el código de seguridad. Solo
    guarda tipo, últimos cuatro dígitos y el
    **token** que devuelve la pasarela; los datos
    bancarios reales los custodia la pasarela.

    Está en amarillo porque **todavía no se eligió
    pasarela** (decisión #12): falta confirmar que
    la elegida soporte tokenización.
  end note

  Estudiante "1" *-- "1" TarjetaVirtual
  Estudiante "1" *-- "0..*" MetodoPago
  TarjetaVirtual "1" *-- "0..*" SaldoEstablecimiento : uno por local
  SaldoEstablecimiento "0..*" --> "1" Proveedor
  SaldoEstablecimiento "1" *-- "0..*" Recarga
  Recarga "0..*" --> "1" Proveedor : destino del dinero
  Recarga "1" *-- "1" ComprobanteRecarga
  Pago "1" --> "0..1" Recarga : genera
  Pago "0..*" --> "0..1" MetodoPago : usa
}

package "Órdenes" {
  enum EstadoOrden {
    COMPRADO
    ENTREGADO
    EXPIRADO
  }

  note right of EstadoOrden
    **EXPIRADO** lo propuso Ingeniería para cubrir
    el vacío de "orden nunca retirada", y el acta
    del 30-jul-2026 **cerró la regla**: la orden
    expira al terminar el día de la compra.

    Lo único que sigue abierto es qué pasa con el
    **dinero** de una orden expirada — el acta fijó
    cuándo vence el código, no la política de
    reembolso. Y la decisión #13 acota las salidas:
    Aliflow no puede devolver dinero porque nunca
    lo tuvo.
  end note

  class Orden {
    - id: UUID
    - proveedor: Proveedor
    - fechaHora: DateTime
    - estado: EstadoOrden
    - esCanje: boolean = false
    - descuento: Money = 0
    - motivoDescuento: String
    + subtotal(): Money
    + total(): Money
    + confirmarCompra(): void
    + marcarEntregado(operador: Operador): void
    + expirar(): void
  }

  note left of Orden
    **descuento / motivoDescuento (8-ago-2026).**
    Negocios definió que el premio de fidelidad se
    cobra como **descuento del 100% con una nota que
    identifica su origen**, no como una venta de $0.

    Por eso la orden conserva el precio original en
    `OrdenDetalle.precioUnitario` y el descuento vive
    aparte: `total() = subtotal() - descuento`.

    Dos ventajas sobre la orden de $0 que Ingeniería
    había propuesto: el local puede ver **cuánto le
    costaron los premios** (con $0 ese dato no existe),
    y el ERP recibe un documento que entiende mejor
    que una venta de importe cero.
  end note

  note bottom of Orden
    **Invariante**: todos los OrdenDetalle
    de una misma Orden deben referenciar
    Platos cuyo Proveedor sea igual a
    Orden.proveedor — una orden nunca
    mezcla platos de locales distintos.
    confirmarCompra() lo valida antes de
    crear la orden.
  end note

  class OrdenDetalle {
    - cantidad: int
    - precioUnitario: Money
  }

  enum EstadoCodigoRetiro {
    VALIDO
    UTILIZADO
    VENCIDO
  }

  class CodigoRetiro {
    - valor: String(6)
    - fechaCompra: Date
    - fechaExpiracion: DateTime
    - estado: EstadoCodigoRetiro
    + validar(): boolean
    + invalidar(): void
    + estaVencido(): boolean
  }

  note left of CodigoRetiro
    <back:#FFF3B0>Acta 30-jul-2026 §6.2 y §6.3 — expiración cerrada.</back>
    El código vale **únicamente el día de la compra**.
    `fechaExpiracion` se calcula como el mínimo entre
    la `horaMaximaRetiro` del local y el fin de ese día.

    Tres estados oficiales: **VALIDO** (disponible),
    **UTILIZADO** (el Operador confirmó la entrega),
    **VENCIDO** (pasó el horario o terminó el día).
    Presentarlo otro día debe mostrarse como vencido.

    Efecto colateral bueno: una ventana de un día
    reduce mucho el universo de códigos vigentes a la
    vez, que es justo lo que hace viable la unicidad
    con solo 6 dígitos (y mitiga el riesgo R-15).
  end note

  note right of CodigoRetiro
    **Decisión de Negocios (28-jul-2026):**
    **código numérico corto** (6 dígitos), no
    UUID ni QR — el estudiante se lo dice al
    Operador de viva voz y este lo digita.
    Unicidad exigida solo entre los códigos
    **vigentes del mismo local** (no global),
    para que 6 dígitos alcancen. Ver el riesgo
    R-15 (adivinación por fuerza bruta) en
    Gestion-de-Riesgos.md.
  end note

  class ComprobanteCompra {
    - id: UUID
    - fechaEmision: DateTime
    - montoTotal: Money
    - sinValidezTributaria: boolean = true
  }

  class RegistroAuditoria {
    - id: UUID
    - entidadAfectada: String
    - accion: String
    - detalle: String
    - fechaHora: DateTime
  }

  note bottom of RegistroAuditoria
    Responde al riesgo R-09 (ver
    Gestion-de-Riesgos.md): registra
    quién ejecutó confirmarCompra(),
    marcarEntregado(), invalidar() y
    distribuir() — operaciones que
    cambian dinero o estado de una orden.
  end note

  Estudiante "1" --> "0..*" Orden : realiza
  Orden "0..*" --> "1" Proveedor
  Orden "1" *-- "1..*" OrdenDetalle
  OrdenDetalle "0..*" --> "1" Plato
  Orden "1" *-- "1" CodigoRetiro
  Orden "1" *-- "0..1" ComprobanteCompra
  Orden "0..*" --> "0..1" Operador : entregada por
  RegistroAuditoria "0..*" --> "1" Usuario : ejecutado por
}

package "Fidelidad" {
  class ProgramaFidelidad << propuesta >> {
    - id: UUID
    - sellosRequeridos: int
    - descripcionPremio: String
    - vigenciaCartillaDias: int
    - maxSellosPorDia: int = 1
    - activo: boolean
    + emitirCartilla(estudiante: Estudiante): Cartilla
  }

  note top of ProgramaFidelidad
    **Reglas confirmadas por Negocios el 8-ago-2026.**
    "Cartilla" es una **tarjeta de sellos de fidelidad**
    — no un paquete prepago de almuerzos, que es lo que
    la misma palabra significa en un documento de otro
    equipo del curso.

    Las cinco reglas quedaron cerradas: sello al
    **retirar**, tope de **1 sello por día**, cartilla
    **por local**, premio como **descuento del 100%**,
    y el programa cuelga de `Proveedor` porque el premio
    lo absorbe el local.

    Siguen sin definirse **solo dos valores**
    (`sellosRequeridos` y `descripcionPremio`), y por
    eso están modelados como configuración y no como
    constantes: definirlos es cargar un dato, no
    rediseñar. Ver Decisiones-Pendientes-Negocios.md,
    punto 9.
  end note

  enum EstadoCartilla {
    EN_CURSO
    COMPLETA
    CANJEADA
    EXPIRADA
  }

  class Cartilla << propuesta >> {
    - id: UUID
    - sellosAcumulados: int
    - estado: EstadoCartilla
    - fechaInicio: DateTime
    - fechaExpiracion: DateTime
    + acreditarSello(orden: Orden): boolean
    + estaCompleta(): boolean
    + canjear(orden: Orden): Canje
  }

  class Sello << propuesta >> {
    - id: UUID
    - fecha: DateTime
  }

  note bottom of Sello
    **Decisión de diseño de Ingeniería:** el sello
    se acredita en `marcarEntregado()`, **no** en
    `confirmarCompra()`. Dos razones:
    (1) una orden comprada y nunca retirada no
    debe sumar — si no, se llena la cartilla
    comprando sin ir a buscar el almuerzo;
    (2) el sello acompaña al acto físico, que es
    lo que el negocio quiere premiar.

    `Sello --> Orden` es 1 a 1 y con restricción
    de unicidad: una orden nunca puede generar
    dos sellos, aunque la entrega se reintente.
  end note

  class Canje << propuesta >> {
    - id: UUID
    - fechaHora: DateTime
    - premioEntregado: String
  }

  note bottom of Canje
    El canje se aplica sobre una **Orden real** con
    `esCanje = true` y un **descuento del 100%**
    rotulado como premio (decisión de Negocios del
    8-ago-2026). No es una venta de $0: conserva el
    precio del plato y lo descuenta entero.

    El plato igual sale del cupo y el ERP igual tiene
    que enterarse — pero ahora recibe una venta con
    descuento, que es una operación normal para un
    ERP, en vez de un importe cero que podría
    rechazar como error. Queda por verificar contra
    la documentación de Contífico y de Alpwin que
    ambos admiten descuento del 100% en línea.

    No descuenta `SaldoEstablecimiento`: el premio lo
    regala el local, no se paga con saldo.
  end note

  Proveedor "1" *-- "0..1" ProgramaFidelidad
  ProgramaFidelidad "1" --> "0..*" Cartilla : emite
  Estudiante "1" --> "0..*" Cartilla : acumula
  Cartilla "1" *-- "0..*" Sello
  Sello "1" --> "1" Orden : acreditado por
  Cartilla "1" --> "0..1" Canje
  Canje "1" --> "1" Orden : aplicado en
  Canje "0..*" --> "1" Operador : validado por
}

package "Integración con ERP externo" {
  interface IInventoryProvider {
    + getMenu(tenantId: UUID): List<CanonicalProduct>
    + getStock(tenantId: UUID, itemId: UUID): int
    + updateStock(tenantId: UUID, itemId: UUID, delta: int): Result
    + notifySale(tenantId: UUID, orden: Orden): Result
    + notifyPayment(tenantId: UUID, orden: Orden, pago: Pago): Result
    + getSyncStatus(tenantId: UUID): SyncStatus
  }

  note right of IInventoryProvider
    La interfaz es **bidireccional** por diseño:
    los métodos de lectura (getMenu/getStock)
    traen el inventario del local hacia Aliflow;
    los de escritura (updateStock/notifySale/
    notifyPayment) devuelven al ERP las órdenes
    y pagos para que su inventario y su
    contabilidad queden sincronizados.
  end note

  class ContificoAdapter implements IInventoryProvider
  class OdooAdapter implements IInventoryProvider
  class AlpwinAdapter implements IInventoryProvider {
    + notifySale(tenantId: UUID, orden: Orden): Result
    .. nota: sin API pública, implementación\npor archivos/BD puente (ver Hallazgos-Ingenieria-API-Generica.md) ..
  }

  class ProviderAdapterFactory {
    + crearAdaptador(proveedor: Proveedor): IInventoryProvider
  }

  enum TipoERP {
    CONTIFICO
    ALPWIN
    ODOO
    OTRO
  }

  note bottom of TipoERP
    Cada local trae su propio ERP —
    Barú → CONTIFICO, Caramel Coffee → ALPWIN.
    Agregar un local con un ERP nuevo = un
    valor de enum + una clase adaptadora,
    cero cambios al core (Open/Closed).
  end note

  class IntegracionERP {
    - id: UUID
    - tipoERP: TipoERP
    - credencialesCifradas: String
    - endpoint: String
    - ultimaSincronizacionExitosa: DateTime
  }

  enum TipoEvento {
    ACTUALIZAR_STOCK
    NOTIFICAR_VENTA
    NOTIFICAR_PAGO
  }

  enum EstadoEvento {
    PENDIENTE
    PROCESADO
    FALLIDO
  }

  class EventoSincronizacion {
    - id: UUID
    - tipoEvento: TipoEvento
    - payload: String
    - estado: EstadoEvento
    - intentos: int
    - fechaCreacion: DateTime
    + reintentar(): void
  }

  class SincronizacionWorker {
    + procesarCola(): void
    - ejecutarEvento(evento: EventoSincronizacion): void
  }

  Proveedor "1" *-- "1" IntegracionERP
  Proveedor "1" *-- "0..*" EventoSincronizacion
  ProviderAdapterFactory ..> IInventoryProvider : crea
  ProviderAdapterFactory ..> IntegracionERP : lee tipoERP
  SincronizacionWorker ..> ProviderAdapterFactory : usa
  SincronizacionWorker "1" ..> "0..*" EventoSincronizacion : procesa
  Orden ..> IInventoryProvider : notifica venta (vía Worker)
}

@enduml
