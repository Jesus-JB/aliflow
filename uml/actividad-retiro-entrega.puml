@startuml actividad-retiro-entrega-aliflow

title Actividad — Retirar y entregar almuerzo (UC5)

|Estudiante|
start
:Se presenta en el\npunto de entrega;

|Operador|
if (¿Tiene código\nde retiro?) then (sí)
  :Capturar el código;
else (no)
  :Buscar orden manualmente\n(nombre / ID institucional);
endif

|Aliflow|
:Buscar la Orden asociada;
if (¿Orden encontrada?) then (no)
  |Operador|
  :Ver error\n("orden no encontrada");
  stop
else (sí)
endif

if (¿Estado == COMPRADO?) then (no)
  |Operador|
  :Ver error\n("ya fue entregada a las HH:MM"\n/ código inválido);
  stop
else (sí)
endif

:Mostrar detalle\n(estudiante, plato) al Operador;

|Operador|
:Entregar físicamente\nel almuerzo;
:Confirmar entrega;

|Aliflow|
:Cambiar estado de la\nOrden a ENTREGADO;
:Invalidar CodigoRetiro\n(uso único);
:Registrar timestamp y Operador\nen RegistroAuditoria;

partition "Fidelidad (propuesta, 28-jul-2026)" {
  if (¿El local tiene\nProgramaFidelidad activo?) then (no)
  else (sí)
    if (¿Ya se acreditó un sello\nhoy en este local?) then (sí)
    else (no)
      :Acreditar Sello en la Cartilla\nvigente del estudiante\n(único por Orden);
      if (¿Cartilla completa?) then (sí)
        :Marcar Cartilla como COMPLETA;
        |Estudiante|
        :Ver aviso de premio disponible;
        |Aliflow|
      else (no)
      endif
    endif
  endif
}
stop

@enduml
