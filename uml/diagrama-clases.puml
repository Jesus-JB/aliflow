@startuml diagrama-clases-aliflow

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

' Convención visual: elementos en amarillo son PROPUESTA DE INGENIERÍA
' pendiente de validar con Negocios, no una decisión ya confirmada.
' Ver Documentacion-Diagrama-Clases.md, sección "Supuestos y pendientes".
skinparam class<<propuesta>> {
  BackgroundColor #FFF3B0
  BorderColor #8A6D00
}
skinparam note<<propuesta>> {
  BackgroundColor #FFF3B0
  BorderColor #8A6D00
}

legend top left
  <back:#FFF3B0>  </back> = propuesta de Ingeniería, pendiente de validar con Negocios
  <back:#F1F1F1>  </back> = confirmado en acta / flujo funcional / decisión de Negocios
endlegend

package "Usuarios" {
  abstract class Usuario {
    # id: UUID
    # nombreCompleto: String
    # email: String
    # fechaRegistro: DateTime
    # activo: boolean
    + autenticar(): Sesion
  }

  class Estudiante extends Usuario {
    - dominioInstitucional: String
    - codigoInstitucional: String
    + consultarSaldo(): Money
  }

  abstract class UsuarioProveedor extends Usuario {
    # proveedor: Proveedor
  }

  class Administrador extends UsuarioProveedor {
    + administrarMenu(): void
    + consultarMetricas(): MetricasProveedor
    + gestionarUsuariosDelLocal(): void
    + configurarIntegracionERP(): IntegracionERP
  }

  class Operador extends UsuarioProveedor {
    - puntoDeEntrega: PuntoDeEntrega
    + buscarOrden(codigo: String): Orden
    + confirmarEntrega(orden: Orden): void
  }

  note bottom of Administrador
    **Vocabulario (decisión de Negocios, 28-jul-2026):**
    el sistema tiene 3 roles: Estudiante, **Proveedor**
    y Operador. El rol de negocio "Proveedor" es esta
    clase `Administrador` — la **persona** que gerencia
    el local. La clase `Proveedor` de abajo es el
    **local/negocio** (el tenant), no una persona.
    No existe un super-admin de plataforma.
  end note
}

package "Proveedor y Menú" {
  class Proveedor {
    - id: UUID
    - nombreComercial: String
    - ruc: String
    - fechaAlta: DateTime
    - activo: boolean
  }

  note right of Proveedor
    El **local** de comida dentro de la universidad
    (Barú, Caramel Coffee, …). Cada uno es un tenant
    independiente, con su propio ERP, su propio menú
    y su propio personal.
  end note

  class PuntoDeEntrega {
    - id: UUID
    - nombre: String
    - ubicacion: String
  }

  class Plato {
    - id: UUID
    - nombre: String
    - descripcion: String
    - precio: Money
    - stockDisponible: int
    - version: int
    - activo: boolean
    + hayStock(cantidad: int): boolean
    + reservarStock(cantidad: int): boolean
  }

  note right of Plato
    **version** habilita bloqueo optimista:
    reservarStock() solo aplica el descuento
    si version no cambió desde la lectura
    (evita que dos compras se lleven la
    última unidad). Detalle exacto de la
    transacción en el diagrama de secuencia.
  end note

  Proveedor "1" *-- "1..*" Administrador : gerencia el local
  Proveedor "1" *-- "0..*" Operador : personal de entrega
  Proveedor "1" *-- "0..*" PuntoDeEntrega
  Proveedor "1" *-- "0..*" Plato : menú
  Operador "0..*" --> "1" PuntoDeEntrega : trabaja en
}

package "Wallet y Pagos" {
  class TarjetaVirtual {
    - id: UUID
    - saldoDisponible: Money
    + descontar(cantidad: Money, proveedor: Proveedor): void
    + acreditar(cantidad: Money): void
  }

  note right of TarjetaVirtual
    **Decisión de Negocios (28-jul-2026):**
    el estudiante hace **una sola recarga**;
    `saldoDisponible` es una bolsa única
    utilizable en cualquier local. Aliflow
    distribuye internamente hacia cada
    proveedor (ver SaldoProveedor).
  end note

  class SaldoProveedor << propuesta >> {
    - montoAcumulado: Money
    + acreditar(cantidad: Money): void
  }

  note bottom of SaldoProveedor
    <back:#FFF3B0>Interpretación de Ingeniería</back> de "Aliflow
    distribuye internamente a todos los
    proveedores": **no** se reparte el dinero
    al recargar (repartir $20 entre N locales
    dejaría al estudiante sin poder comprar
    en ninguno), sino que se lleva un libro
    interno de cuánto le corresponde a cada
    local, acreditado **en el momento de la
    compra**. Es lo que Aliflow le liquida al
    local. Pendiente de confirmar con Negocios.
  end note

  class Recarga {
    - id: UUID
    - montoTotal: Money
    - fechaHora: DateTime
    + aplicar(tarjeta: TarjetaVirtual): void
  }

  interface EstrategiaDistribucionRecarga {
    + distribuir(monto: Money, tarjeta: TarjetaVirtual): void
  }

  class DistribucionBajoDemanda implements EstrategiaDistribucionRecarga

  note bottom of DistribucionBajoDemanda
    Implementación **elegida** por Negocios
    (28-jul-2026): recarga única a la bolsa
    común; la acreditación al local ocurre
    al comprar. La alternativa que se evaluó
    —`RecargaDirectaPorProveedor`, recargar
    explícitamente por local— quedó descartada;
    la interfaz se conserva porque el reparto
    (comisiones, retenciones) todavía puede
    cambiar sin tocar el resto del modelo.
  end note

  class ComprobanteRecarga {
    - id: UUID
    - fechaEmision: DateTime
    - sinValidezTributaria: boolean = true
  }

  enum EstadoPago {
    APROBADO
    PENDIENTE
    RECHAZADO
  }

  class Pago {
    - id: UUID
    - monto: Money
    - metodoPago: String
    - estado: EstadoPago
    - fechaHora: DateTime
  }

  Estudiante "1" *-- "1" TarjetaVirtual
  TarjetaVirtual "1" *-- "0..*" SaldoProveedor
  SaldoProveedor "0..*" --> "1" Proveedor
  TarjetaVirtual "1" *-- "0..*" Recarga
  Recarga "1" ..> "1" EstrategiaDistribucionRecarga : usa
  Recarga "1" *-- "1" ComprobanteRecarga
  Pago "1" --> "0..1" Recarga : genera
}

package "Órdenes" {
  enum EstadoOrden {
    COMPRADO
    ENTREGADO
    EXPIRADO
  }

  note right of EstadoOrden
    <back:#FFF3B0>EXPIRADO es propuesta de Ingeniería</back>
    (no estaba en el flujo original) para
    cubrir el vacío de "orden nunca
    retirada" — falta que Negocios defina
    la regla de expiración exacta.
  end note

  class Orden {
    - id: UUID
    - proveedor: Proveedor
    - fechaHora: DateTime
    - estado: EstadoOrden
    - esCanje: boolean = false
    + confirmarCompra(): void
    + marcarEntregado(operador: Operador): void
    + expirar(): void
  }

  note bottom of Orden
    **Invariante**: todos los OrdenDetalle
    de una misma Orden deben referenciar
    Platos cuyo Proveedor sea igual a
    Orden.proveedor — una orden nunca
    mezcla platos de locales distintos.
    confirmarCompra() lo valida antes de
    crear la orden.
  end note

  class OrdenDetalle {
    - cantidad: int
    - precioUnitario: Money
  }

  class CodigoRetiro {
    - valor: String(6)
    - fechaExpiracion: DateTime
    - usado: boolean
    + validar(): boolean
    + invalidar(): void
  }

  note right of CodigoRetiro
    **Decisión de Negocios (28-jul-2026):**
    **código numérico corto** (6 dígitos), no
    UUID ni QR — el estudiante se lo dice al
    Operador de viva voz y este lo digita.
    Unicidad exigida solo entre los códigos
    **vigentes del mismo local** (no global),
    para que 6 dígitos alcancen. Ver el riesgo
    R-15 (adivinación por fuerza bruta) en
    Gestion-de-Riesgos.md.
  end note

  class ComprobanteCompra {
    - id: UUID
    - fechaEmision: DateTime
    - montoTotal: Money
    - sinValidezTributaria: boolean = true
  }

  class RegistroAuditoria {
    - id: UUID
    - entidadAfectada: String
    - accion: String
    - detalle: String
    - fechaHora: DateTime
  }

  note bottom of RegistroAuditoria
    Responde al riesgo R-09 (ver
    Gestion-de-Riesgos.md): registra
    quién ejecutó confirmarCompra(),
    marcarEntregado(), invalidar() y
    distribuir() — operaciones que
    cambian dinero o estado de una orden.
  end note

  Estudiante "1" --> "0..*" Orden : realiza
  Orden "0..*" --> "1" Proveedor
  Orden "1" *-- "1..*" OrdenDetalle
  OrdenDetalle "0..*" --> "1" Plato
  Orden "1" *-- "1" CodigoRetiro
  Orden "1" *-- "0..1" ComprobanteCompra
  Orden "0..*" --> "0..1" Operador : entregada por
  RegistroAuditoria "0..*" --> "1" Usuario : ejecutado por
}

package "Fidelidad" {
  class ProgramaFidelidad << propuesta >> {
    - id: UUID
    - sellosRequeridos: int
    - descripcionPremio: String
    - vigenciaCartillaDias: int
    - maxSellosPorDia: int = 1
    - activo: boolean
    + emitirCartilla(estudiante: Estudiante): Cartilla
  }

  note top of ProgramaFidelidad
    <back:#FFF3B0>Requisito nuevo (28-jul-2026),</back> todo el paquete
    es propuesta de Ingeniería: "cartilla de
    fidelidad" — el estudiante acumula sellos
    por compra y al completarla gana un premio.
    Negocios todavía no definió cuántos sellos
    ni cuál es el premio, así que ambos son
    **configuración** (`sellosRequeridos`,
    `descripcionPremio`), no constantes: se
    pueden cambiar sin tocar código.

    El programa cuelga de **Proveedor**, no de
    la plataforma: el premio lo absorbe el local,
    así que cada local define el suyo. Ver
    Decisiones-Pendientes-Negocios.md, punto 9.
  end note

  enum EstadoCartilla {
    EN_CURSO
    COMPLETA
    CANJEADA
    EXPIRADA
  }

  class Cartilla << propuesta >> {
    - id: UUID
    - sellosAcumulados: int
    - estado: EstadoCartilla
    - fechaInicio: DateTime
    - fechaExpiracion: DateTime
    + acreditarSello(orden: Orden): boolean
    + estaCompleta(): boolean
    + canjear(orden: Orden): Canje
  }

  class Sello << propuesta >> {
    - id: UUID
    - fecha: DateTime
  }

  note bottom of Sello
    **Decisión de diseño de Ingeniería:** el sello
    se acredita en `marcarEntregado()`, **no** en
    `confirmarCompra()`. Dos razones:
    (1) una orden comprada y nunca retirada no
    debe sumar — si no, se llena la cartilla
    comprando sin ir a buscar el almuerzo;
    (2) el sello acompaña al acto físico, que es
    lo que el negocio quiere premiar.

    `Sello --> Orden` es 1 a 1 y con restricción
    de unicidad: una orden nunca puede generar
    dos sellos, aunque la entrega se reintente.
  end note

  class Canje << propuesta >> {
    - id: UUID
    - fechaHora: DateTime
    - premioEntregado: String
  }

  note bottom of Canje
    El canje se aplica sobre una **Orden real**
    con `esCanje = true` y total $0: el plato
    igual sale del inventario y el ERP del local
    igual tiene que enterarse. Ojo con esto —
    un `notifySale` de $0 puede parecerle un
    error al ERP; hay que emitirlo como
    documento de cortesía/descuento 100%, y eso
    se resuelve distinto en Contífico que en
    Alpwin. Pendiente de verificar.

    Tampoco acredita `SaldoProveedor`: Aliflow
    no le debe nada al local por un premio que
    el local mismo decidió regalar.
  end note

  Proveedor "1" *-- "0..1" ProgramaFidelidad
  ProgramaFidelidad "1" --> "0..*" Cartilla : emite
  Estudiante "1" --> "0..*" Cartilla : acumula
  Cartilla "1" *-- "0..*" Sello
  Sello "1" --> "1" Orden : acreditado por
  Cartilla "1" --> "0..1" Canje
  Canje "1" --> "1" Orden : aplicado en
  Canje "0..*" --> "1" Operador : validado por
}

package "Integración con ERP externo" {
  interface IInventoryProvider {
    + getMenu(tenantId: UUID): List<CanonicalProduct>
    + getStock(tenantId: UUID, itemId: UUID): int
    + updateStock(tenantId: UUID, itemId: UUID, delta: int): Result
    + notifySale(tenantId: UUID, orden: Orden): Result
    + notifyPayment(tenantId: UUID, orden: Orden, pago: Pago): Result
    + getSyncStatus(tenantId: UUID): SyncStatus
  }

  note right of IInventoryProvider
    La interfaz es **bidireccional** por diseño:
    los métodos de lectura (getMenu/getStock)
    traen el inventario del local hacia Aliflow;
    los de escritura (updateStock/notifySale/
    notifyPayment) devuelven al ERP las órdenes
    y pagos para que su inventario y su
    contabilidad queden sincronizados.
  end note

  class ContificoAdapter implements IInventoryProvider
  class OdooAdapter implements IInventoryProvider
  class AlpwinAdapter implements IInventoryProvider {
    + notifySale(tenantId: UUID, orden: Orden): Result
    .. nota: sin API pública, implementación\npor archivos/BD puente (ver Hallazgos-Ingenieria-API-Generica.md) ..
  }

  class ProviderAdapterFactory {
    + crearAdaptador(proveedor: Proveedor): IInventoryProvider
  }

  enum TipoERP {
    CONTIFICO
    ALPWIN
    ODOO
    OTRO
  }

  note bottom of TipoERP
    Cada local trae su propio ERP —
    Barú → CONTIFICO, Caramel Coffee → ALPWIN.
    Agregar un local con un ERP nuevo = un
    valor de enum + una clase adaptadora,
    cero cambios al core (Open/Closed).
  end note

  class IntegracionERP {
    - id: UUID
    - tipoERP: TipoERP
    - credencialesCifradas: String
    - endpoint: String
    - ultimaSincronizacionExitosa: DateTime
  }

  enum TipoEvento {
    ACTUALIZAR_STOCK
    NOTIFICAR_VENTA
    NOTIFICAR_PAGO
  }

  enum EstadoEvento {
    PENDIENTE
    PROCESADO
    FALLIDO
  }

  class EventoSincronizacion {
    - id: UUID
    - tipoEvento: TipoEvento
    - payload: String
    - estado: EstadoEvento
    - intentos: int
    - fechaCreacion: DateTime
    + reintentar(): void
  }

  class SincronizacionWorker {
    + procesarCola(): void
    - ejecutarEvento(evento: EventoSincronizacion): void
  }

  Proveedor "1" *-- "1" IntegracionERP
  Proveedor "1" *-- "0..*" EventoSincronizacion
  ProviderAdapterFactory ..> IInventoryProvider : crea
  ProviderAdapterFactory ..> IntegracionERP : lee tipoERP
  SincronizacionWorker ..> ProviderAdapterFactory : usa
  SincronizacionWorker "1" ..> "0..*" EventoSincronizacion : procesa
  Orden ..> IInventoryProvider : notifica venta (vía Worker)
}

@enduml
