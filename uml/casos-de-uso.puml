@startuml casos-de-uso-aliflow

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

' Convención visual: amarillo = propuesta de Ingeniería, pendiente de
' validar con Negocios. Ver Documentacion-Casos-de-Uso.md.
legend top left
  <back:#FFF3B0>  </back> = propuesta de Ingeniería, pendiente de validar con Negocios
  <back:#F1F1F1>  </back> = confirmado en acta / flujo funcional
endlegend

actor Estudiante as EST
actor Proveedor as PROV
actor Operador as OP
actor "Administrador\n(super-admin de Aliflow)" as ADMIN
actor "Proveedor de Identidad\n(Google OAuth)" as IDP
actor "Sistema ERP del Proveedor\n(Odoo / Contífico / Alpwin,\nvía API genérica)" as ERP

rectangle "Aliflow" {

  ' ---- Estudiante ----
  usecase "UC1. Iniciar sesión institucional" as UC1
  usecase "Autenticar con proveedor de identidad" as UC1a
  usecase "Crear perfil y tarjeta virtual\n(primer ingreso)" as UC1b

  usecase "UC2. Recargar saldo" as UC2
  usecase "Generar comprobante de recarga" as UC2a

  usecase "UC3. Consultar menú del día" as UC3
  usecase "Sincronizar catálogo con\nsistema del proveedor" as UC3a

  usecase "UC4. Comprar almuerzo" as UC4
  usecase "Validar saldo y disponibilidad" as UC4a
  usecase "Generar comprobante de compra" as UC4b
  usecase "Notificar venta al sistema\ndel proveedor (API genérica)" as UC4c

  usecase "UC5. Retirar y entregar almuerzo" as UC5
  usecase "Buscar orden\n(código o manual)" as UC5a
  usecase "Validar y confirmar entrega" as UC5b
  usecase "Manejar excepción de entrega" as UC5c

  ' ---- Proveedor / Operador ----
  usecase "UC6. Iniciar sesión operativa" as UC6

  usecase "UC7. Configurar integración\ncon sistema externo" as UC7

  usecase "UC8. Administrar menú" as UC8

  usecase "UC9. Consultar métricas y operación" as UC9

  usecase "UC10. Consultar estado\nde sincronización" as UC10

  usecase "UC11. Consultar detalle de venta\n(soporte re-emisión de comprobante)" as UC11

  ' ---- Administrador (pendiente de definición detallada, ver documentación) ----
  usecase "UC12. Dar de alta / gestionar proveedores" as UC12 #FFF3B0
  usecase "UC13. Consultar métricas globales\nde la plataforma" as UC13 #FFF3B0
  usecase "UC14. Gestionar usuarios y roles" as UC14 #FFF3B0
}

' ---- Asociaciones actor - caso de uso ----
EST --> UC1
EST --> UC2
EST --> UC3
EST --> UC4
EST --> UC5

OP --> UC5
OP --> UC6

PROV --> UC6
PROV --> UC7
PROV --> UC8
PROV --> UC9
PROV --> UC10
PROV --> UC11

IDP --> UC1a
ERP --> UC3a
ERP --> UC4c
ERP --> UC7
ERP --> UC11

ADMIN --> UC12
ADMIN --> UC13
ADMIN --> UC14
ADMIN --> UC6

' ---- Include / Extend ----
UC1 .> UC1a : <<include>>
UC1 .> UC1b : <<extend>>

UC2 .> UC2a : <<include>>

UC3 .> UC3a : <<include>>

UC4 .> UC4a : <<include>>
UC4 .> UC4b : <<include>>
UC4 .> UC4c : <<include>>

UC5 .> UC5a : <<include>>
UC5 .> UC5b : <<include>>
UC5 .> UC5c : <<extend>>

note right of ADMIN
  Rol confirmado como distinto de Proveedor
  (super-admin de la plataforma Aliflow),
  pero su alcance detallado (UC12-UC14)
  aún no ha sido definido formalmente
  por Negocios/el equipo. Ver
  Documentacion-Casos-de-Uso.md.
end note

@enduml
