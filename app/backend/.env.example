# Copiar a .env y completar. .env nunca se sube al repositorio.
ALIFLOW_ENTORNO=desarrollo
ALIFLOW_DATABASE_URL=postgresql+psycopg://aliflow:aliflow@localhost:5432/aliflow

# RF-01: dominio de las cuentas de Google aceptadas para Estudiantes.
ALIFLOW_DOMINIO_INSTITUCIONAL=uees.edu.ec
# Client ID de OAuth de Google Cloud (tipo "Aplicación web"). Ver app/README.md.
ALIFLOW_GOOGLE_CLIENT_ID=

# true en producción: la cookie de sesión solo viaja por HTTPS.
ALIFLOW_COOKIE_SEGURA=false

# RF-05: minutos de inactividad antes de expirar la sesión, por rol.
ALIFLOW_INACTIVIDAD_OPERADOR_MIN=120
