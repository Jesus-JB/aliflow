# Copiar a .env.local. Nunca se sube al repositorio.

# Dónde corre la API. Next reescribe /api/* hacia acá (ver next.config.ts).
ALIFLOW_API_URL=http://localhost:8000

# Mismo client ID de OAuth que usa el backend (ALIFLOW_GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_DOMINIO_INSTITUCIONAL=uees.edu.ec
